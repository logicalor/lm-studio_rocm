# Ubuntu version for the base Docker image
# Available versions: 20.04, 22.04, 24.04
# Check available tags: https://hub.docker.com/r/rocm/dev-ubuntu-22.04/tags
# Must be compatible with your chosen ROCm version
UBUNTU_VERSION=22.04

# ROCm version for the base Docker image
# Determines which ROCm version is used in the container
# Available versions: 5.7, 6.0, 6.1, 6.2, 6.3, etc.
# Check compatibility matrix: https://rocm.docs.amd.com/en/latest/release/gpu_os_support.html
# Verify your GPU is supported: https://rocm.docs.amd.com/projects/install-on-linux/en/latest/reference/system-requirements.html
ROCM_VERSION=6.2

# HSA override for GPU compatibility
# Override the GPU architecture version reported to ROCm (gfx version)
# Only needed if your GPU is not officially supported or you want to use a compatible architecture
# 
# To find your GPU's gfx version, run: rocminfo | grep "Name:" -A 5
# Common values:
#   - 9.0.0 = gfx900 (Vega 10/20: RX Vega 56/64, Radeon VII)
#   - 10.1.0 = gfx1010 (Navi 10: RX 5000 series)
#   - 10.3.0 = gfx1030 (Navi 21/22: RX 6000 series)
#   - 11.0.0 = gfx1100 (Navi 31/32/33: RX 7000 series)
#
# GPU architecture reference: https://rocm.docs.amd.com/en/latest/release/gpu_os_support.html
# Leave as default (10.3.0) if unsure, or comment out to disable override
HSA_OVERRIDE_GFX_VERSION=10.3.0

# Host directory for model weights
# This folder is mounted into the container at /root/.cache/lm-studio
# Models downloaded or placed here persist across container restarts
# Must be an absolute path on your host machine
# 
# Recommended: Ensure you have sufficient disk space (models can be 4-70GB each)
# Example: /home/youruser/lm-studio-models or /data/ai-models
MODELS_DIR=./models

# GPU selection for ROCm
# Controls which GPUs are visible to the container via HIP_VISIBLE_DEVICES
# 
# To list available GPUs on your host, run: rocm-smi or rocminfo
# Options:
#   - "all" = expose all available GPUs
#   - "0" = expose only GPU 0 (first GPU)
#   - "0,2" = expose GPUs 0 and 2 (comma-separated, no spaces)
#   - "1" = expose only GPU 1 (second GPU)
#
# ROCm GPU tools: https://rocm.docs.amd.com/projects/rocm-smi-lib/en/latest/
GPU_IDS=all

# Host port mapping
# Maps the LM Studio API/web interface to this port on your host
# Container always uses port 1234 internally
# 
# Access the web interface at: http://localhost:<PORT>
# API endpoint will be at: http://localhost:<PORT>/v1
# Change this if port 1234 is already in use on your host
PORT=1234

# VNC web interface port
# Access the LM Studio GUI via web browser at: http://localhost:<VNC_PORT>
# Default: 6080
VNC_PORT=6080
